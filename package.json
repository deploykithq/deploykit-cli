{
  "name": "@deploykit/cli",
  "version": "0.2.0",
  "description": "Install, update, and manage a self-hosted DeployKit instance on a Linux VPS.",
  "keywords": [
    "deploykit",
    "paas",
    "self-hosted",
    "docker",
    "cli",
    "vps",
    "deploy"
  ],
  "homepage": "https://github.com/deploykithq/deploykit-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/deploykithq/deploykit-cli.git"
  },
  "bugs": {
    "url": "https://github.com/deploykithq/deploykit-cli/issues"
  },
  "license": "MIT",
  "author": "DeployKit",
  "type": "module",
  "bin": {
    "deploykit": "dist/bin/deploykit.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/postbuild.mjs",
    "clean": "rimraf dist",
    "dev": "tsx src/bin/deploykit.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "ora": "^8.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/prompts": "^2.4.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
